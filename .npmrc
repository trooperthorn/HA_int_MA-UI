# Security Settings
#
# Dependency install scripts are gated by pnpm itself, not by this setting:
# since pnpm 10 a dependency's preinstall/install/postinstall is refused
# unless the package is listed in `allowBuilds` in pnpm-workspace.yaml (see
# `pnpm approve-builds`). That allowlist is the control, and it currently
# permits only @parcel/watcher, esbuild and vue-demi.
#
# So this stays false on purpose. Setting it to true would also block the
# allowlisted native builds and this package's own scripts (husky `prepare`),
# which breaks the install without adding protection.
ignore-scripts=false

# Use npm registry with strict SSL
registry=https://registry.npmjs.org/
strict-ssl=true

# Enable audit checks
audit=true
audit-level=moderate
